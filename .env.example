# CloudPulse environment configuration.
# Copy to `.env` (never commit `.env`) and replace the placeholder values:
#   PowerShell:  Copy-Item .env.example .env
#
# Docker Compose and the backend both read this file. Values below that are
# commented out show the defaults the backend uses when the variable is unset.

# --- PostgreSQL (required) ---------------------------------------------------
POSTGRES_PASSWORD=change-me-local-dev-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=cloudpulse
# POSTGRES_USER=cloudpulse

# --- Redis / Celery ----------------------------------------------------------
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Authentication -----------------------------------------------------------
# The first person to open the dashboard creates the admin account.
# SESSION_TTL_HOURS=12
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15

# --- API ---------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=false
# JSON list of browser origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# MAX_UPLOAD_BYTES=20971520

# --- Notifications (email via local Mailpit by default) ----------------------
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM=cloudpulse@localhost
# NOTIFICATION_TIMEOUT_SECONDS=5

# --- Live billing connectors (AWS CUR / Cost Explorer, OpenAI, Anthropic) ----
# Fernet key that encrypts connector credentials at rest. Connectors are disabled
# until it is set. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key: CONNECTOR_ENCRYPTION_KEY=new-key,old-key
# CONNECTOR_ENCRYPTION_KEY=
# CONNECTOR_TIMEOUT_SECONDS=30
# CONNECTOR_MAX_DOWNLOAD_BYTES=2147483648

# --- Frontend (read by Next.js; put in frontend/.env.local if running locally) -
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
